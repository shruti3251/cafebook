# Copy this file to ".env" and fill in the values from
# Firebase console > Project settings > General > Your apps > Web app config
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# The public address printed inside table QR codes. Leave EMPTY to use the
# address the dashboard is opened from (e.g. your-site.netlify.app).
# Set it to https://cafebook.in once your domain is live, then reprint QR codes.
VITE_PUBLIC_URL=
